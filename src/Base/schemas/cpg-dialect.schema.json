{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shiftleft.io/codepropertygraph/schema/dialect/2026-10",
  "$dynamicAnchor": "meta",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/unevaluated": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true,
    "https://json-schema.org/draft/2020-12/vocab/meta-data": true,
    "https://json-schema.org/draft/2020-12/vocab/format-annotation": true,
    "https://json-schema.org/draft/2020-12/vocab/content": true,
    "https://shiftleft.io/codepropertygraph/schema/vocab/core/2026-10": true
  },
  "allOf": [
    {
      "$ref": "https://json-schema.org/draft/2020-12/schema"
    }
  ],
  "properties": {
    "cpg:moduleName": {
      "type": "string",
      "minLength": 1
    },
    "cpg:docIndex": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "cpg:providedByFrontend": {
      "type": "boolean"
    },
    "cpg:properties": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/cpgProperty"
      }
    },
    "cpg:nodeBaseTypes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/cpgNodeBaseType"
      }
    },
    "cpg:edgeTypes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/cpgEdgeType"
      }
    }
  },
  "required": [
    "cpg:moduleName",
    "cpg:docIndex",
    "cpg:providedByFrontend"
  ],
  "$defs": {
    "cpgProtoId": {
      "type": "string",
      "minLength": 1
    },
    "cpgProperty": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "string",
            "boolean",
            "integer"
          ]
        },
        "description": {
          "type": "string"
        },
        "default": true,
        "cpg:mandatory": {
          "type": "boolean"
        },
        "cpg:protoId": {
          "$ref": "#/$defs/cpgProtoId"
        }
      },
      "required": [
        "type",
        "description",
        "cpg:protoId"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "cpg:mandatory": {
                "const": true
              }
            },
            "required": [
              "cpg:mandatory"
            ]
          },
          "then": {
            "required": [
              "default"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "string"
              }
            },
            "required": [
              "default"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "boolean"
              }
            },
            "required": [
              "default"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "integer"
              }
            },
            "required": [
              "default"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "integer"
              }
            }
          }
        }
      ]
    },
    "cpgNodeBaseType": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "cpg:properties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "description",
        "cpg:properties"
      ],
      "additionalProperties": false
    },
    "cpgEdgeType": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "cpg:protoId": {
          "$ref": "#/$defs/cpgProtoId"
        }
      },
      "required": [
        "description",
        "cpg:protoId"
      ],
      "additionalProperties": false
    }
  }
}

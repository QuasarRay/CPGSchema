{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shiftleft.io/codepropertygraph/schema/meta/type-layer/2026-10",
  "title": "CPG Type layer model meta-schema",
  "allOf": [
    {
      "$ref": "https://shiftleft.io/codepropertygraph/schema/meta/type-layer-vocabulary/2026-10"
    },
    {
      "type": "object",
      "properties": {
        "$schema": {
          "const": "https://shiftleft.io/codepropertygraph/schema/dialect/type-layer/2026-10"
        },
        "$id": { "type": "string", "minLength": 1 },
        "title": { "const": "Type" },
        "description": { "type": "string" },
        "cpg:layerName": { "const": "Type" },
        "cpg:docIndex": { "const": 6 },
        "cpg:providedByFrontend": { "const": true }
      },
      "required": [
        "$schema",
        "$id",
        "title",
        "description",
        "cpg:layerName",
        "cpg:docIndex",
        "cpg:providedByFrontend",
        "cpg:imports",
        "cpg:properties",
        "cpg:nodeTypes",
        "cpg:edgeTypes",
        "cpg:outEdges",
        "cpg:derivedEdges",
        "cpg:references"
      ],
      "cpg:wellFormedTypeLayer": true
    }
  ]
}

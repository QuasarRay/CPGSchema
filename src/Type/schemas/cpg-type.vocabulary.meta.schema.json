{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shiftleft.io/codepropertygraph/schema/meta/type-layer-vocabulary/2026-10",
  "title": "CPG Type-layer vocabulary",
  "description": "Syntax for declaratively expressing FlatGraph/CPG properties, node types, edge types, endpoint relations, derived edges, and cross-node property references.",
  "type": [
    "object",
    "boolean"
  ],
  "properties": {
    "cpg:layerName": {
      "type": "string",
      "minLength": 1
    },
    "cpg:docIndex": {
      "type": "integer",
      "minimum": 0
    },
    "cpg:providedByFrontend": {
      "type": "boolean"
    },
    "cpg:imports": {
      "$ref": "#/$defs/imports"
    },
    "cpg:properties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/property"
      }
    },
    "cpg:nodeTypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nodeType"
      }
    },
    "cpg:edgeTypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edgeType"
      }
    },
    "cpg:outEdges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outEdge"
      }
    },
    "cpg:derivedEdges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/derivedEdge"
      }
    },
    "cpg:references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "cpg:wellFormedTypeLayer": {
      "const": true
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "nameArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/name"
      },
      "uniqueItems": true
    },
    "imports": {
      "type": "object",
      "properties": {
        "properties": {
          "$ref": "#/$defs/nameArray"
        },
        "nodeTypes": {
          "$ref": "#/$defs/nameArray"
        },
        "nodeBaseTypes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "$ref": "#/$defs/name"
              },
              "properties": {
                "$ref": "#/$defs/nameArray"
              }
            },
            "required": [
              "name",
              "properties"
            ],
            "additionalProperties": false
          }
        },
        "edgeTypes": {
          "$ref": "#/$defs/nameArray"
        }
      },
      "required": [
        "properties",
        "nodeTypes",
        "nodeBaseTypes",
        "edgeTypes"
      ],
      "additionalProperties": false
    },
    "property": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "valueType": {
          "enum": [
            "String",
            "Boolean",
            "Byte",
            "Short",
            "Int",
            "Long",
            "Float",
            "Double",
            "Char"
          ]
        },
        "cardinality": {
          "enum": [
            "optional",
            "one",
            "list"
          ]
        },
        "default": true,
        "protoId": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "valueType",
        "cardinality",
        "protoId",
        "description"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "cardinality": {
                "const": "one"
              }
            },
            "required": [
              "cardinality"
            ]
          },
          "then": {
            "required": [
              "default"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "nodeType": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "protoId": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string"
        },
        "properties": {
          "$ref": "#/$defs/nameArray"
        },
        "extends": {
          "$ref": "#/$defs/nameArray"
        },
        "primaryKey": {
          "$ref": "#/$defs/name"
        },
        "starterName": {
          "$ref": "#/$defs/name"
        }
      },
      "required": [
        "name",
        "protoId",
        "description",
        "properties"
      ],
      "additionalProperties": false
    },
    "edgeType": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "protoId": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "protoId",
        "description"
      ],
      "additionalProperties": false
    },
    "outEdge": {
      "type": "object",
      "properties": {
        "outNode": {
          "$ref": "#/$defs/name"
        },
        "edge": {
          "$ref": "#/$defs/name"
        },
        "inNode": {
          "$ref": "#/$defs/name"
        },
        "stepNameOut": {
          "$ref": "#/$defs/name"
        },
        "stepNameIn": {
          "$ref": "#/$defs/name"
        },
        "stepNameInDoc": {
          "type": "string"
        }
      },
      "required": [
        "outNode",
        "edge",
        "inNode"
      ],
      "additionalProperties": false
    },
    "derivedEdge": {
      "type": "object",
      "properties": {
        "edge": {
          "$ref": "#/$defs/name"
        },
        "sourceNode": {
          "$ref": "#/$defs/name"
        },
        "sourceProperty": {
          "$ref": "#/$defs/name"
        },
        "sourceCardinality": {
          "enum": [
            "optional",
            "one",
            "list"
          ]
        },
        "targetNode": {
          "$ref": "#/$defs/name"
        },
        "targetProperty": {
          "$ref": "#/$defs/name"
        },
        "targetCardinality": {
          "enum": [
            "exactlyOne",
            "atLeastOne"
          ]
        },
        "createdBy": {
          "const": "loader"
        },
        "frontendCreates": {
          "const": false
        }
      },
      "required": [
        "edge",
        "sourceNode",
        "sourceProperty",
        "sourceCardinality",
        "targetNode",
        "targetProperty",
        "createdBy",
        "frontendCreates"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "sourceNode": {
          "$ref": "#/$defs/name"
        },
        "sourceProperty": {
          "$ref": "#/$defs/name"
        },
        "targetNode": {
          "$ref": "#/$defs/name"
        },
        "targetProperty": {
          "$ref": "#/$defs/name"
        },
        "targetCardinality": {
          "enum": [
            "exactlyOne",
            "atLeastOne"
          ]
        }
      },
      "required": [
        "sourceNode",
        "sourceProperty",
        "targetNode",
        "targetProperty",
        "targetCardinality"
      ],
      "additionalProperties": false
    }
  }
}
